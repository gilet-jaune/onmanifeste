{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Protest historical events",
  "type": "object",
  "required": ["kinds", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "$ref": "resources.schema.json#/$defs/localized"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title", "kind", "url", "description"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "description": {
            "$ref": "resources.schema.json#/$defs/localized"
          },
          "gains": {
            "type": "object",
            "description": "What the movement obtained (rights, withdrawals, abandoned projects).",
            "required": ["fr"],
            "additionalProperties": false,
            "properties": {
              "fr": {
                "type": "string"
              },
              "en": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "pattern": "^https://",
                "description": "Source for the gains when not covered by the event url."
              }
            }
          }
        }
      }
    }
  }
}
