{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Protest historical events",
  "type": "object",
  "required": ["kinds", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "$ref": "resources.schema.json#/$defs/localized"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "kind", "url", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique, stable anchor (#evt-<id>): year + slug."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "End of a period (YYYY, YYYY-MM or YYYY-MM-DD)."
          },
          "title": {
            "$ref": "resources.schema.json#/$defs/localized"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "description": {
            "$ref": "resources.schema.json#/$defs/localized"
          },
          "gains": {
            "type": "object",
            "description": "What the movement obtained (rights, withdrawals, abandoned projects).",
            "required": ["fr"],
            "additionalProperties": false,
            "properties": {
              "fr": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "check": {
            "$ref": "resources.schema.json#/properties/resources/items/properties/check"
          },
          "evidence": {
            "type": "array",
            "description": "Ids from docs/data/sources.json documenting the facts (ruling, report, authenticated video, official statement).",
            "items": {
              "type": "string"
            }
          },
          "debunked": {
            "type": "object",
            "description": "An official statement later contradicted by established facts.",
            "required": ["claim", "fact"],
            "additionalProperties": false,
            "properties": {
              "claim": {
                "$ref": "resources.schema.json#/$defs/localized"
              },
              "fact": {
                "$ref": "resources.schema.json#/$defs/localized"
              }
            }
          },
          "related": {
            "type": "array",
            "description": "Ids of related events (\"see also\").",
            "items": {
              "type": "string"
            }
          },
          "guides": {
            "type": "array",
            "description": "Slugs of useful guides (docs/guides/<slug>.md).",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
