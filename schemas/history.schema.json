{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "On manifeste historical events",
  "type": "object",
  "required": ["kinds", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "$ref": "resources.schema.json#/$defs/localized"
      }
    },
    "natures": {
      "type": "object",
      "description": "What kind of source an event rests on (decision, ongoing proceedings, parliamentary, journalistic or NGO investigation).",
      "additionalProperties": {
        "$ref": "resources.schema.json#/$defs/localized"
      }
    },
    "actors": {
      "type": "object",
      "description": "The institution an event comes from (who decided or acted): government, Parliament, courts, police, independent bodies, UN and Europe, civil society. Institutions, never named people.",
      "additionalProperties": {
        "$ref": "resources.schema.json#/$defs/localized"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "kinds", "url", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique, stable anchor (#evt-<id>): year + slug."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "End of a period (YYYY, YYYY-MM or YYYY-MM-DD)."
          },
          "title": {
            "$ref": "resources.schema.json#/$defs/localized"
          },
          "kinds": {
            "type": "array",
            "description": "Themes of the event, keys of the top-level `kinds`. The first is the main one (label, dot colour); the others make the event appear under those themes too (filters, thematic pages).",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "actors": {
            "type": "array",
            "description": "Institutions the event comes from, keys of the top-level `actors`; several are allowed (the first is the main one). Institutions only, never named people.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "natures": {
            "type": "array",
            "description": "Nature of the event, keys of the top-level `natures`; several are allowed (the first is the main one). A journalistic or NGO investigation is not a decision: say which it is.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "summary": {
            "$ref": "resources.schema.json#/$defs/localized",
            "description": "Optional short text shown on the timeline card (about 200 characters); the full description opens in a dialog."
          },
          "description": {
            "$ref": "resources.schema.json#/$defs/localized"
          },
          "gains": {
            "type": "object",
            "description": "What the movement obtained (rights, withdrawals, abandoned projects).",
            "required": ["fr"],
            "additionalProperties": false,
            "properties": {
              "fr": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "check": {
            "$ref": "resources.schema.json#/properties/resources/items/properties/check"
          },
          "evidence": {
            "type": "array",
            "description": "Ids from docs/data/sources.json documenting the facts (ruling, report, authenticated video, official statement).",
            "items": {
              "type": "string"
            }
          },
          "debunked": {
            "type": "object",
            "description": "An official statement later contradicted by established facts.",
            "required": ["claim", "fact"],
            "additionalProperties": false,
            "properties": {
              "claim": {
                "$ref": "resources.schema.json#/$defs/localized"
              },
              "fact": {
                "$ref": "resources.schema.json#/$defs/localized"
              }
            }
          },
          "related": {
            "type": "array",
            "description": "Ids of related events (\"see also\").",
            "items": {
              "type": "string"
            }
          },
          "guides": {
            "type": "array",
            "description": "Slugs of useful guides (docs/guides/<slug>.md).",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
